{
  "name": "portfolio-analytics-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-analytics --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio-analytics --remote",
    "check": "node --check src/index.js && node --check src/push.js && node --check public/app.js && node --check public/sw.js",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.0-beta",
    "wrangler": "^4.43.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0"
  }
}
